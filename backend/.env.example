# Copy to backend/.env (git-ignored) and fill in. Shell variables take precedence.

# Pandit answer synthesis: providers are tried in this order.
LLM_PROVIDERS=groq,openrouter,gemma
GROQ_API_KEY=
# Comma-separated: on a rate limit the next model is tried (Groq free tier: per model, 8k tokens/min, 200k/day).
GROQ_MODEL=openai/gpt-oss-120b,qwen/qwen3.8-27b
# Picks which stats queries answer a question.
GROQ_PLAN_MODEL=openai/gpt-oss-20b,qwen/qwen3.8-27b,openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Optional local completion server (last resort).
GEMMA_API_BASE=http://127.0.0.1:8080
GEMMA_MODEL=gemma-4-E4B
# MAC_SERVING_API_KEY=

# Data locations (defaults under backend/data/, git-ignored).
# CRICSHEET_DIR=
# CRICBOT_CACHE_DIR=
